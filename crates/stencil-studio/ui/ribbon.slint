// Ribbon building blocks: tab strip, groups, large/small buttons, labeled sliders.

import { Slider } from "std-widgets.slint";
import { Theme, Hint } from "theme.slint";

export component RibbonButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <bool> checked: false;
    in property <bool> large: true;
    callback clicked;

    min-width: root.large ? 58px : 0px;
    height: root.large ? 68px : 24px;
    border-radius: 4px;
    border-width: root.checked ? 1px : 0px;
    border-color: Theme.accent;
    background: !root.enabled ? transparent
        : ta.pressed ? Theme.pressed
        : root.checked ? Theme.accent-soft
        : ta.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        changed has-hover => {
            Hint.text = self.has-hover ? (root.tooltip != "" ? root.tooltip : root.text) : "";
        }
    }

    if root.large: VerticalLayout {
        padding: 4px;
        padding-top: 6px;
        spacing: 3px;
        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 26px;
                height: 26px;
                colorize: root.enabled ? (root.checked ? Theme.accent : Theme.text) : Theme.text-faint;
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? Theme.text : Theme.text-faint;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            wrap: word-wrap;
            vertical-alignment: top;
            vertical-stretch: 1;
        }
    }
    if !root.large: HorizontalLayout {
        padding-left: 4px;
        padding-right: 8px;
        spacing: 6px;
        Image {
            source: root.icon;
            width: 16px;
            y: (parent.height - self.height) / 2;
            height: 16px;
            colorize: root.enabled ? (root.checked ? Theme.accent : Theme.text) : Theme.text-faint;
        }
        Text {
            text: root.text;
            color: root.enabled ? Theme.text : Theme.text-faint;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
    }
}

export component RibbonGroup inherits Rectangle {
    in property <string> title;
    VerticalLayout {
        padding-left: 6px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 3px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 2px;
            alignment: start;
            vertical-stretch: 1;
            @children
        }
        Text {
            text: root.title;
            color: Theme.text-faint;
            font-size: 10.5px;
            horizontal-alignment: center;
        }
    }
    Rectangle {
        x: parent.width - 1px;
        y: 8px;
        width: 1px;
        height: parent.height - 16px;
        background: Theme.border;
    }
}

// A compact labeled slider for the ribbon / properties panel.
export component LabeledSlider inherits VerticalLayout {
    in property <string> label;
    in property <string> value-text;
    in property <string> tooltip;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <bool> enabled: true;
    in-out property <float> value;
    callback changed(float);

    spacing: 0px;
    alignment: center;
    HorizontalLayout {
        Text {
            text: root.label;
            color: Theme.text-dim;
            font-size: Theme.font-small;
            horizontal-stretch: 1;
        }
        Text {
            text: root.value-text;
            color: Theme.text;
            font-size: Theme.font-small;
            font-weight: 600;
        }
    }
    s := Slider {
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        enabled: root.enabled;
        value <=> root.value;
        changed(v) => { root.changed(v); }
    }
}

export component RibbonTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    width: label.preferred-width + 28px;
    background: root.active ? Theme.ribbon : ta.has-hover ? Theme.hover : transparent;
    border-radius: 0px;
    accessible-role: tab;
    accessible-label: root.text;
    label := Text {
        text: root.text;
        color: root.active ? Theme.text : Theme.text-dim;
        font-size: Theme.font-normal;
        font-weight: root.active ? 600 : 400;
    }
    if root.active: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        width: parent.width - 16px;
        background: Theme.accent;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}
