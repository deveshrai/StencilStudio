// Visual tokens for StencilStudio's "pro" dark theme.

export global Theme {
    out property <color> bg: #1c1d20;
    out property <color> canvas: #151618;
    out property <color> panel: #232428;
    out property <color> panel-header: #1f2023;
    out property <color> ribbon: #2a2b30;
    out property <color> ribbon-tabs: #1f2023;
    out property <color> border: #38393f;
    out property <color> text: #e4e5e8;
    out property <color> text-dim: #9b9da4;
    out property <color> text-faint: #6c6e75;
    out property <color> accent: #4c8dff;
    out property <color> accent-soft: #4c8dff33;
    out property <color> hover: #ffffff12;
    out property <color> pressed: #ffffff22;
    out property <color> warning: #f0b429;
    out property <length> font-small: 11px;
    out property <length> font-normal: 12.5px;
}

// Hover hint mirrored into the status bar (like classic desktop apps).
export global Hint {
    in-out property <string> text;
}
